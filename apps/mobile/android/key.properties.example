# Copy to android/key.properties. Do not commit that file or the keystore.
# storeFile is relative to apps/mobile/android/ unless it is absolute.
# If MOBILE_KEYSTORE_PASSWORD is set in the environment, it replaces both
# storePassword and keyPassword. keyAlias defaults to sbexpress when omitted.
storeFile=/absolute/path/sbexpress-release.keystore
storePassword=
keyAlias=sbexpress
keyPassword=
