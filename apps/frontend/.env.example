# Copy to `.env` (gitignored) if you need to override anything.
#
# Base URL of the backend API. Leave empty in development — the Vite dev
# server proxies /api to http://localhost:3002 (see vite.config.ts), so the
# browser stays on one origin and CORS never enters the picture. Set it for a
# deployed frontend that talks to a separately hosted API, e.g.
# VITE_API_BASE_URL="https://api.sbx.example.com"
VITE_API_BASE_URL=""
