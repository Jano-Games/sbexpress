# Copy to `.env` (gitignored) for local development.
#
# `pnpm infra` starts Postgres on 5435 and Redis on 6382 — the defaults below
# match docker-compose.yml, so locally nothing needs changing.

MEDIA_CLEANUP_ENABLED="true"
NODE_ENV="development"
PORT="3002"
APP_NAME="Sichuan Bangla Express"

DATABASE_URL="postgresql://postgres:postgres123@localhost:5435/mamun_local"
REDIS_URL="redis://localhost:6382"

# Base URL used when building customer tracking links.
PUBLIC_TRACK_BASE_URL="http://localhost:5178"

# AeroDataBox via RapidAPI — powers the flight-schedule search in the Add
# flight form. Leave blank to get labeled sample data instead of live times.
# Free tier is ~800 requests/month; responses are cached in Redis.
AERODATABOX_RAPIDAPI_KEY=""

# Comma-separated browser origins allowed to call the API. In development the
# Vite proxy makes the browser see one origin, so CORS never enters the picture.
ALLOWED_ORIGINS="http://localhost:5178"

# Private R2 bucket; create bucket-scoped Object Read & Write credentials.
# Never put these values in a VITE_ variable or frontend build.
R2_ACCOUNT_ID=""
R2_BUCKET=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""

# Stable 32-byte hex key for saved customer links. Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Keep this server-only key across restarts and deployments.
LINK_ENCRYPTION_KEY=""
